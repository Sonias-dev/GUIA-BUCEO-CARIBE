rules_version = '2';

// ============================================================
//  Reglas de seguridad – Guía de buceo en el Caribe colombiano
//  Roles:
//   - Usuario: cualquier cuenta con sesión iniciada.
//   - Administrador: cuenta cuyo ID (uid) existe en la colección "admins".
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function sesionIniciada() {
      return request.auth != null;
    }

    function esAdmin() {
      return sesionIniciada()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- Administradores ----------
    // Cada usuario solo puede consultar su propio registro (para saber si es admin).
    // Nadie puede crear administradores desde la página: se crean en la consola de Firebase.
    match /admins/{uid} {
      allow read: if sesionIniciada() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Contenido de la guía ----------
    // Todos los usuarios con sesión leen; solo el administrador crea, edita o borra.
    match /contenido/{documento} {
      allow read: if sesionIniciada();
      allow create, update, delete: if esAdmin();
    }

    // ---------- Reservas ----------
    match /reservas/{reserva} {

      // Fecha AAAA-MM-DD entre ayer (margen de zona horaria) y un año adelante
      function fechaValida(f) {
        return f is string
          && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2]))
               > request.time - duration.value(2, 'd')
          && timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2]))
               < request.time + duration.value(366, 'd');
      }

      // El destino debe existir en la guía y ser de tipo "destino"
      function destinoValido(id) {
        return id is string
          && exists(/databases/$(database)/documents/contenido/$(id))
          && get(/databases/$(database)/documents/contenido/$(id)).data.tipo == 'destino';
      }

      function reservaValida(d) {
        return d.keys().hasOnly(['uid', 'correo', 'nombre', 'telefono', 'destinoId', 'destino', 'fecha',
                                 'personas', 'nivel', 'servicio', 'comentarios', 'confirmaEdad',
                                 'estado', 'creado', 'actualizado'])
          && d.keys().hasAll(['uid', 'correo', 'nombre', 'telefono', 'destinoId', 'destino', 'fecha',
                              'personas', 'nivel', 'servicio', 'confirmaEdad', 'estado',
                              'creado', 'actualizado'])
          && d.uid == request.auth.uid
          && d.correo == request.auth.token.email
          && d.estado == 'pendiente'
          && d.creado == request.time
          && d.actualizado == request.time
          && d.confirmaEdad == true
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 100
          && d.telefono is string && d.telefono.matches('^[+]?[0-9][0-9 ()-]{6,19}$')
          && destinoValido(d.destinoId)
          && d.destino is string && d.destino.size() >= 2 && d.destino.size() <= 120
          && fechaValida(d.fecha)
          && d.personas is int && d.personas >= 1 && d.personas <= 20
          && d.nivel in ['principiante', 'certificado']
          && d.servicio in ['bautismo', 'open_water', 'certificados']
          // Las inmersiones para certificados solo las puede reservar un buzo certificado
          && (d.servicio != 'certificados' || d.nivel == 'certificado')
          && (!('comentarios' in d) || (d.comentarios is string && d.comentarios.size() <= 500));
      }

      // Crear: cualquier usuario, solo a su nombre, con estado "pendiente" y datos válidos.
      allow create: if sesionIniciada() && reservaValida(request.resource.data);

      // Leer: el dueño de la reserva o el administrador.
      allow read: if sesionIniciada()
        && (resource.data.uid == request.auth.uid || esAdmin());

      // Actualizar:
      //  - Administrador: valida (confirma / rechaza / vuelve a pendiente) y deja una nota.
      //    Una reserva cancelada por el usuario ya no se puede modificar.
      //  - Usuario: solo puede cancelar sus reservas que siguen pendientes.
      allow update: if
        (esAdmin()
          && resource.data.estado != 'cancelada'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'notaAdmin', 'revisadoPor', 'actualizado'])
          && request.resource.data.estado in ['pendiente', 'confirmada', 'rechazada']
          && request.resource.data.revisadoPor == request.auth.uid
          && request.resource.data.actualizado == request.time
          && (!('notaAdmin' in request.resource.data)
              || (request.resource.data.notaAdmin is string
                  && request.resource.data.notaAdmin.size() <= 300)))
        ||
        (sesionIniciada()
          && resource.data.uid == request.auth.uid
          && resource.data.estado == 'pendiente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizado'])
          && request.resource.data.estado == 'cancelada'
          && request.resource.data.actualizado == request.time);

      // Borrar: solo el administrador.
      allow delete: if esAdmin();
    }
  }
}
